# Copy to .env (untracked, invariant I6). Never commit real keys.
# All optional at M0/M1 — Track A (Dataverse) needs no credentials.

# CoinGecko (Track B market cap + volume). Free tier works; pro key optional.
COINGECKO_API_KEY=

# Exchange OHLCV via ccxt. READ-ONLY keys only — invariant I7 forbids
# any write/trade scope. Public OHLCV endpoints need no key at all.
BINANCE_API_KEY=
BINANCE_API_SECRET=
