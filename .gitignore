# Secrets (invariant I6) — never commit
.env
.env.*
!.env.example

# Data (invariant I5) — parquet/duckdb artifacts stay local
data/
*.parquet
*.duckdb
*.duckdb.wal

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Generated reports keep their directory but not stale renders
reports/*.html
reports/*.png

# OS
.DS_Store
